DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=true

POSTGRES_DB=published
POSTGRES_USER=published
POSTGRES_PASSWORD=published

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com

# IA: mock (padrão, simulado) ou openrouter (requer OPENROUTER_API_KEY)
AI_PROVIDER=mock
AI_MODELO_PADRAO=nvidia/nemotron-3-super-120b-a12b:free
AI_TIMEOUT_SECONDS=30
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# API interna (opcional): exige X-Internal-Token em /api/execucoes e /api/noticias
INTERNAL_API_TOKEN=

# Credenciais opcionais das fontes (referência usada em Fonte.credencial_ref)
GITHUB_TOKEN=
HF_TOKEN=

# Orçamento (USD)
ORCAMENTO_DIARIO=5
ORCAMENTO_MENSAL=30
