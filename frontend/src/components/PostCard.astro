---
import { formatDate } from "../lib/api";
interface Props {
  item: { slug: string; titulo: string; resumo?: string; publicado_em?: string; secao: string };
}
const { item } = Astro.props;
---
<article class="border-t-2 border-destaque pt-3">
  <a href={`/artigo/${item.slug}`} class="block">
    <h3 class="text-lg font-bold leading-snug text-principal hover:text-destaque">{item.titulo}</h3>
  </a>
  {item.resumo && <p class="mt-1 text-sm text-texto-sec">{item.resumo}</p>}
  <p class="mt-1 text-xs text-texto-sec">{formatDate(item.publicado_em)}</p>
</article>
