---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ConteudoGrid from "../../components/ConteudoGrid.astro";
import EmptyState from "../../components/EmptyState.astro";
import ErrorState from "../../components/ErrorState.astro";
import { getSecao } from "../../lib/api";

const { secao } = Astro.params;
const data = await getSecao(secao);
if (!data) {
  Astro.response.status = 404;
}
---
<BaseLayout title={data ? `Seção: ${secao}` : "Página não encontrada"}>
  {!data ? (
    <ErrorState />
  ) : (
    <>
      <h1 class="mb-4 border-b border-borda pb-2 text-2xl font-extrabold text-principal">{secao}</h1>
      {data.itens.length === 0 ? (
        <EmptyState texto="Sem conteúdo publicado nesta seção." />
      ) : (
        <ConteudoGrid itens={data.itens} />
      )}
    </>
  )}
</BaseLayout>
