---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Kicker from "../../components/Kicker.astro";
import ItemCard from "../../components/ItemCard.astro";
import TransparencyBanner from "../../components/TransparencyBanner.astro";
import ErrorState from "../../components/ErrorState.astro";
import { getArtigo, formatDate } from "../../lib/api";
import { marked } from "marked";
import sanitizeHtml from "sanitize-html";

const { slug } = Astro.params;
const artigo = await getArtigo(slug);
if (!artigo) {
  Astro.response.status = 404;
}
const ehLista = artigo?.tipo === "lista";
const corpoHtml = artigo ? sanitizeHtml(marked.parse(artigo.corpo || "")) : "";
---
<BaseLayout title={artigo ? artigo.titulo : "Página não encontrada"} description={artigo?.resumo}>
  {!artigo ? (
    <ErrorState />
  ) : (
    <article class="mx-auto max-w-3xl">
      <Kicker texto={artigo.secao} />
      <h1 class="mt-1 text-3xl font-extrabold leading-tight text-principal sm:text-4xl">{artigo.titulo}</h1>
      <p class="mt-2 text-sm text-texto-sec">{formatDate(artigo.publicado_em)}</p>
      {artigo.resumo && <p class="mt-4 text-lg text-texto-sec">{artigo.resumo}</p>}
      <div class="conteudo mt-6 font-serif text-lg leading-8 text-principal" set:html={corpoHtml} />

      {artigo.fontes?.length > 0 && (
        <section class="mt-8">
          <h2 class="mb-2 text-sm font-bold uppercase tracking-wide text-texto-sec">Fontes</h2>
          <ul class="list-inside list-disc text-sm text-destaque">
            {artigo.fontes.map((url) => (
              <li><a href={url} target="_blank" rel="noopener" class="hover:underline">{url}</a></li>
            ))}
          </ul>
        </section>
      )}

      {ehLista && artigo.aviso_curadoria && (
        <p class="mt-6 rounded-md border border-complementar/40 bg-complementar/10 px-4 py-3 text-sm text-texto-sec">
          {artigo.aviso_curadoria}
        </p>
      )}

      {ehLista && artigo.itens?.length > 0 && (
        <section class="mt-8">
          <h2 class="mb-4 border-b border-borda pb-1 text-xl font-bold text-principal">Itens</h2>
          <div class="grid gap-4 sm:grid-cols-2">
            {artigo.itens.map((item) => (
              <ItemCard slug={slug} ordem={item.ordem} dados={item.dados} />
            ))}
          </div>
        </section>
      )}

      <TransparencyBanner />
    </article>
  )}
</BaseLayout>
