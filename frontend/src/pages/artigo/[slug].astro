---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getArtigo, formatDate } from "../../lib/api";

const { slug } = Astro.params;
const artigo = await getArtigo(slug);

if (!artigo) {
  return Astro.redirect("/404");
}
---
<BaseLayout title={artigo.titulo} description={artigo.resumo}>
  <article class="artigo">
    <span class="kicker">{artigo.secao}</span>
    <h1>{artigo.titulo}</h1>
    <p class="meta">{formatDate(artigo.publicado_em)} · conteúdo assistido por IA, revisado por humano</p>
    <p class="resumo">{artigo.resumo}</p>
    <div class="corpo">{artigo.corpo}</div>
  </article>
  <style>
    .artigo { max-width: 72ch; }
    .resumo { font-size: 18px; color: #333; }
    .corpo { white-space: pre-wrap; line-height: 1.7; }
  </style>
</BaseLayout>
