---
import BaseLayout from "../layouts/BaseLayout.astro";
import ConteudoCard from "../components/ConteudoCard.astro";
import Kicker from "../components/Kicker.astro";
import EmptyState from "../components/EmptyState.astro";
import { getHome, formatDate } from "../lib/api";

const home = await getHome();
const hero = home.artigos[0] ?? null;
const demais = home.artigos.slice(1);
const blocos = [
  { titulo: "Destaques GitHub", href: "/secao/destaques-github", itens: home.destaques_github },
  { titulo: "Radar Hugging Face", href: "/secao/radar-hf", itens: home.radar_hf },
];
const vazio = home.artigos.length === 0 && home.destaques_github.length === 0 && home.radar_hf.length === 0;
---
<BaseLayout title="Published Tech" description="Análises de IA, software e infraestrutura.">
  {vazio ? (
    <EmptyState />
  ) : (
    <>
      {hero && (
        <section class="mb-10 grid gap-6 md:grid-cols-2 md:items-center">
          <a href={`/artigo/${hero.slug}`} class="block overflow-hidden rounded-lg border border-borda">
            <img
              src="/placeholder.svg"
              alt="Ilustração gerada por IA (simulada)"
              width="640"
              height="360"
              class="h-56 w-full object-cover"
            />
          </a>
          <div>
            <Kicker texto={hero.secao} />
            <a href={`/artigo/${hero.slug}`} class="group">
              <h1 class="mt-1 text-3xl font-extrabold leading-tight text-principal group-hover:text-destaque sm:text-4xl">
                {hero.titulo}
              </h1>
            </a>
            {hero.resumo && <p class="mt-2 text-lg text-texto-sec">{hero.resumo}</p>}
            <p class="mt-1 text-sm text-texto-sec">{formatDate(hero.publicado_em)}</p>
          </div>
        </section>
      )}

      <section>
        <h2 class="mb-4 border-b border-borda pb-1 text-xl font-bold text-principal">Últimas</h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {demais.map((item) => <ConteudoCard item={item} />)}
        </div>
      </section>

      {blocos.map((bloco) => (
        <section class="mt-12">
          <h2 class="mb-4 border-b border-borda pb-1 text-xl font-bold text-principal">
            <a href={bloco.href} class="hover:text-destaque">{bloco.titulo}</a>
          </h2>
          {bloco.itens.length === 0 ? (
            <EmptyState texto="Sem itens por enquanto." />
          ) : (
            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {bloco.itens.map((item) => <ConteudoCard item={item} />)}
            </div>
          )}
        </section>
      ))}
    </>
  )}
</BaseLayout>
